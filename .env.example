# Copy to .env and set the endpoint approved for the pilot.
# The provider is not part of the code: any OpenAI-compatible endpoint works.
# AG-01 used RouterAI only as a comparison transport.
# TASKMASTER_MODEL_BASE_URL is the API root, for example https://host/v1
# without the /chat/completions suffix; the client appends it.
TASKMASTER_MODEL_API_KEY=
TASKMASTER_MODEL_BASE_URL=
TASKMASTER_MODEL=
TASKMASTER_MODEL_TIMEOUT_SECONDS=90
